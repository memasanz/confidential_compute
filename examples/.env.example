# Copy this file to `.env` and fill in your values. Do NOT commit `.env`.

# Entra tenant that owns the app registrations.
MCP_TENANT_ID=

# The on-prem agent's service principal (client-credentials flow).
MCP_CLIENT_ID=
# Use a secret VALUE from the client app above, not the API app or a secret ID.
MCP_CLIENT_SECRET=

# The confidential sandbox API app registration (token v2 audience GUID).
MCP_API_APP_ID=

# Private MCP endpoint (reachable over the VPN / inside the VNet).
MCP_ENDPOINT=https://REPLACE_PRIVATE_IP:8000/mcp

# Optional: path to the spreadsheet to analyze (defaults to sample_sales.xlsx).
# MCP_EXCEL_PATH=sample_sales.xlsx

# --- Agent Framework (Layer 2) notebook only ---
# Azure OpenAI model that powers the agent's reasoning. API keys are disabled,
# so the model call authenticates with Entra (DefaultAzureCredential).
# Use the Azure OpenAI resource endpoint, not a Foundry /api/projects/... URL.
AZURE_OPENAI_ENDPOINT=https://your-endpoint.openai.azure.com
AZURE_OPENAI_CHAT_DEPLOYMENT=your-model-deployment
