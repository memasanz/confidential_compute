# Copy this file to `.env` and fill in your values. Do NOT commit `.env`.

# Entra tenant that owns the app registrations.
MCP_TENANT_ID=

# Service principal that holds the Sandbox.Access role (client-credentials flow).
# Leave MCP_CLIENT_SECRET empty only if direct user sign-in is configured on the API.
# az login alone does not grant Sandbox.Access or pre-authorize Azure CLI.
MCP_CLIENT_ID=
# Use a secret VALUE from the client app above, not the API app or a secret ID.
MCP_CLIENT_SECRET=

# The pool gateway API app registration (token v2 audience GUID).
# The client requests api://<MCP_API_APP_ID>/.default, not a Foundry token.
MCP_API_APP_ID=

# Pool gateway MCP endpoint (reachable over the VPN / inside the VNet).
POOL_GATEWAY_URL=https://pool-gateway.REPLACE_ENV_DOMAIN/mcp

# PEM verified against the fingerprint published by your administrator.
# Relative paths below are resolved from the examples directory, not the shell cwd.
POOL_GATEWAY_CA=gateway-cert.pem

# Optional: path to the spreadsheet to analyze (defaults to sample_sales.xlsx).
# MCP_EXCEL_PATH=sample_sales.xlsx

# Agent Framework only: Foundry model inference (separate credentials/permissions).
# DefaultAzureCredential uses your local az login or separately configured identity.
# Do not put the MCP app's secret into AZURE_CLIENT_SECRET unless intentionally
# using that same identity for Foundry and granting it the necessary permissions.
FOUNDRY_PROJECT_ENDPOINT=https://REPLACE_RESOURCE.services.ai.azure.com/api/projects/REPLACE_PROJECT
FOUNDRY_MODEL=REPLACE_MODEL_DEPLOYMENT
