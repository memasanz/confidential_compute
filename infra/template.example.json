{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "name": { "type": "string", "defaultValue": "mcp-build-sandbox" },
    "location": { "type": "string", "defaultValue": "eastus2" },
    "image": { "type": "string" },
    "registryServer": { "type": "string" },
    "registryUsername": { "type": "string" },
    "registryPassword": { "type": "securestring" },
    "mcpAuthKid": { "type": "string" },
    "maaEndpoint": { "type": "string", "defaultValue": "sharedeus2.eus2.attest.azure.net" },
    "akvEndpoint": { "type": "string" },
    "entraTenantId": { "type": "string" },
    "entraAudience": { "type": "string" },
    "managedIdentityResourceId": { "type": "string" },
    "tlsCert": { "type": "securestring" },
    "tlsKey": { "type": "securestring" },
    "attestationSidecarImage": { "type": "string", "defaultValue": "mcr.microsoft.com/aci/skr:2.7" },
    "cpuCores": { "type": "int", "defaultValue": 2 },
    "memoryInGb": { "type": "int", "defaultValue": 4 }
  },
  "resources": [
    {
      "type": "Microsoft.ContainerInstance/containerGroups",
      "apiVersion": "2023-05-01",
      "name": "[parameters('name')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": { "[parameters('managedIdentityResourceId')]": {} }
      },
      "properties": {
        "confidentialComputeProperties": { "ccePolicy": "" },
        "sku": "Confidential",
        "osType": "Linux",
        "restartPolicy": "Always",
        "imageRegistryCredentials": [
          {
            "server": "[parameters('registryServer')]",
            "username": "[parameters('registryUsername')]",
            "password": "[parameters('registryPassword')]"
          }
        ],
        "containers": [
          {
            "name": "mcp-server",
            "properties": {
              "image": "[parameters('image')]",
              "ports": [ { "port": 8000, "protocol": "TCP" } ],
              "environmentVariables": [
                { "name": "MCP_AUTH_KID", "value": "[parameters('mcpAuthKid')]" },
                { "name": "SKR_MAA_ENDPOINT", "value": "[parameters('maaEndpoint')]" },
                { "name": "SKR_AKV_ENDPOINT", "value": "[parameters('akvEndpoint')]" },
                { "name": "ENTRA_TENANT_ID", "value": "[parameters('entraTenantId')]" },
                { "name": "ENTRA_AUDIENCE", "value": "[parameters('entraAudience')]" },
                { "name": "MCP_TLS_CERT", "secureValue": "[parameters('tlsCert')]" },
                { "name": "MCP_TLS_KEY", "secureValue": "[parameters('tlsKey')]" },
                { "name": "ATTESTATION_SIDECAR_URL", "value": "http://localhost:8080" }
              ],
              "resources": {
                "requests": { "cpu": "[parameters('cpuCores')]", "memoryInGB": "[parameters('memoryInGb')]" }
              }
            }
          },
          {
            "name": "attestation-sidecar",
            "properties": {
              "image": "[parameters('attestationSidecarImage')]",
              "ports": [ { "port": 8080, "protocol": "TCP" } ],
              "resources": { "requests": { "cpu": 1, "memoryInGB": 1 } }
            }
          }
        ],
        "ipAddress": {
          "type": "Public",
          "ports": [ { "port": 8000, "protocol": "TCP" } ]
        }
      }
    }
  ],
  "outputs": {
    "mcpEndpoint": {
      "type": "string",
      "value": "[concat('https://', reference(resourceId('Microsoft.ContainerInstance/containerGroups', parameters('name'))).ipAddress.ip, ':8000/mcp')]"
    }
  }
}
