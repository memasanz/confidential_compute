    "image": { "value": "REPLACE_ACR.azurecr.io/mcp-build-sandbox:1.0" },
    "registryServer": { "value": "REPLACE_ACR.azurecr.io" },
    "registryUsername": { "value": "REPLACE_ACR" },
    "registryPassword": {
      "reference": {
        "keyVault": {
          "id": "/subscriptions/REPLACE_SUB/resourceGroups/REPLACE_RG/providers/Microsoft.KeyVault/vaults/REPLACE_KV"
